{
  "name": "flamer-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages && vite build -c vite.sw.config.ts && cp dist/index.html dist/404.html",
    "preview:pages": "vite preview --mode pages",
    "build:server": "vite build -c vite.server.config.ts",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "~1.2.15",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
